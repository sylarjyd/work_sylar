generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  type      String   @default("personal")
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now())
  users     User[]
  sessions  Session[]
  subscription Subscription?
  credit       TenantCredit?
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  status       String   @default("active")
  role         String   @default("member")
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  sessions     Session[]

  @@index([tenantId])
}

model Session {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String   @default("新会话")
  // 标题来源：auto 待自动生成 | generated 自动生成 | manual 用户改名，自动生成不再覆盖。
  titleSource String @default("auto")
  status    String   @default("active") // active | archived（运营端）| deleted（用户删除，软删除）
  // 用户置顶：列表排序优先展示，不改变 createdAt。
  pinned    Boolean  @default(false)
  // 创建任务时选定的模型；历史会话为空，首次成功预占后回填。
  model     String?
  // 会话创建时选定的自定义助手；助手被删除后置空，会话退化为默认助手。
  assistantId String?
  // 任务分类：chat 对话 | task 任务 | code 编码；会话创建后固定，运行期影响提示词取向。
  mode      String   @default("chat")
  createdAt DateTime @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  assistant Assistant? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  messages  Message[]
  tasks     Task[]
  artifacts Artifact[]
  attachments Attachment[]

  @@index([tenantId, userId, status, pinned, createdAt])
  @@index([assistantId])
}

/// 用户自定义助手：系统提示词、技能、权限模式、默认模型与知识库范围。
/// 会话只保存 assistantId，运行期读取助手最新配置，编辑后对已有会话立即生效。
model Assistant {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  name           String
  description    String   @default("")
  systemPrompt   String   @default("")
  permissionMode String   @default("standard") // standard | readonly | auto
  model          String?
  skills         String[] @default([])
  kbIds          String[] @default([])
  /// @deprecated 旧文档级绑定：由 backfill-kb.mjs 转换到 kbIds 并清空，下一版删除该列。
  kbDocIds       String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessions       Session[]

  @@unique([tenantId, userId, name])
  @@index([tenantId, userId])
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  seq       Int
  tokens    Int?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
  attachments Attachment[]

  @@unique([sessionId, seq])
}

/// 聊天附件：先上传（sessionId/messageId 为空），发送时在事务内绑定到用户消息。
/// 文本类附件由 runtime 按需抽取正文，二进制附件按模型模态下发。
model Attachment {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  sessionId  String?
  messageId  String?
  kind       String
  filename   String
  mime       String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([sessionId])
  @@index([messageId])
}

model Task {
  id         String    @id @default(uuid())
  sessionId  String
  goal       String
  status     String    @default("queued")
  /// 入队时的运行快照：消息历史、助手配置、会话模型、traceId；重试复用。
  input      Json?
  /// 已创建的运行次数（含重试）。
  attempts   Int       @default(0)
  lastError  String?
  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  session    Session   @relation(fields: [sessionId], references: [id])
  runs       Run[]

  @@index([sessionId])
  @@index([status, queuedAt])
}

model Run {
  id                String    @id @default(uuid())
  taskId            String
  attempt           Int       @default(1)
  status            String    @default("queued")
  startedAt         DateTime?
  endedAt           DateTime?
  cancelRequestedAt DateTime?
  traceId           String?
  task              Task      @relation(fields: [taskId], references: [id])
  steps             Step[]
  artifacts         Artifact[]
  checkpoint        RunCheckpoint?

  @@index([taskId])
  @@index([status, startedAt])
  @@index([traceId])
  @@index([startedAt])
}

/// 最后完整轮次的状态快照；仅保留每 run 一行。
model RunCheckpoint {
  runId       String   @id
  /// 下一轮起始下标（已完成 round+1 轮）。
  round       Int
  /// 下一事件序号（已落库步骤的最大 seq + 1）。
  seq         Int
  /// 截至该轮的全部 assistant/tool 消息（累计），BFF 覆盖保存并原样回放，避免半轮历史与首跑分叉。
  deltas      Json
  usage       Json
  /// 已落库的产物 ID；恢复时删除未列入的记录，避免半轮产物重复。
  artifactIds Json
  updatedAt   DateTime @updatedAt
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Step {
  id      String   @id @default(uuid())
  runId   String
  seq     Int
  type    String
  payload Json
  ts      DateTime @default(now())
  run     Run      @relation(fields: [runId], references: [id])

  @@unique([runId, seq])
  @@index([ts])
}

model Artifact {
  id         String   @id @default(uuid())
  tenantId   String
  sessionId  String
  runId      String
  kind       String   // docx | xlsx | pptx
  filename   String
  storageKey String
  size       Int
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id])
  run        Run      @relation(fields: [runId], references: [id])

  @@index([sessionId])
  @@index([tenantId])
}

/// 知识库：每用户可建多个，同名唯一；文档与助手绑定都落到这一层。
model KnowledgeBase {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  docs        KbDoc[]

  @@unique([tenantId, userId, name])
  @@index([tenantId, userId])
  @@index([tenantId])
}

model KbDoc {
  id              String         @id @default(uuid())
  tenantId        String
  userId          String
  // 本版可空以兼容存量数据：回填脚本补齐后由服务层强制赋值，下一版再改 NOT NULL。
  knowledgeBaseId String?
  filename        String
  mime            String
  size            Int
  storageKey      String
  status          String         @default("pending") // pending | ready | failed
  chunkCount      Int            @default(0)
  error           String?
  createdAt       DateTime       @default(now())
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          KbChunk[]

  @@index([tenantId, userId])
  @@index([knowledgeBaseId])
  @@index([tenantId, userId, knowledgeBaseId])
}

model KbChunk {
  id        String                      @id @default(uuid())
  docId     String
  tenantId  String
  userId    String
  seq       Int
  text      String
  // pgvector 列：Prisma 无法原生建模；写入/向量查询走 $executeRaw / $queryRaw（见 §4.3）。
  vector    Unsupported("vector(1024)")
  createdAt DateTime                    @default(now())
  doc       KbDoc                       @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([tenantId, userId])
}

model Connector {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  command         String
  args            Json
  // AES-256-GCM: base64(IV ‖ authTag ‖ ciphertext)；永不回传前端。
  envEncrypted    String
  enabled         Boolean   @default(true)
  toolCount       Int       @default(0)
  lastValidatedAt DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Plan {
  id                  String         @id
  name                String
  priceCents          Int
  monthlyBaseCredits  Int
  monthlyBonusCredits Int
  maxCreditsPerRun    Int
  rpm                 Int
  allowedModels       String[]
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  subscriptions       Subscription[]
}

model Subscription {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  planId      String
  status      String   @default("active")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        Plan     @relation(fields: [planId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([planId])
}

model CreditLot {
  id        String    @id @default(uuid())
  tenantId  String
  source    String
  granted   Int
  remaining Int
  expiresAt DateTime?
  note      String?
  createdAt DateTime  @default(now())

  @@index([tenantId, expiresAt])
  @@index([expiresAt])
}

model CreditTx {
  id        String   @id @default(uuid())
  tenantId  String
  type      String
  amount    Int
  source    String?
  runId     String?  @unique
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model TenantCredit {
  tenantId  String   @id
  balance   Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model CreditHold {
  runId     String   @id
  tenantId  String
  amount    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([tenantId])
  @@index([expiresAt])
}

model UsageRecord {
  id           String    @id @default(uuid())
  runId        String    @unique
  tenantId     String
  userId       String
  sessionId    String
  models       Json
  inputTokens  Int
  outputTokens Int
  credits      Int?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  settledAt    DateTime?

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model ModelProvider {
  id         String        @id @default(uuid())
  name       String        @unique
  baseUrl    String
  apiKeyEnc  String
  apiKeyHint String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  models     ModelConfig[]
}

model ModelConfig {
  model                   String         @id
  providerId              String?
  displayName             String?
  enabled                 Boolean        @default(false)
  /** 模型支持的输入/输出模态：text | image | audio | video。 */
  modalities              String[]       @default(["text"])
  /** 模型能力分类：chat | embedding | rerank | tts | asr；对话模型必须含 chat。 */
  capabilities            String[]       @default(["chat"])
  sortOrder               Int            @default(0)
  inputMilliCreditsPer1k  Int
  outputMilliCreditsPer1k Int
  updatedAt               DateTime       @updatedAt
  provider                ModelProvider? @relation(fields: [providerId], references: [id], onDelete: Restrict)

  // 保留原表名，存量价格行无需迁移数据。
  @@map("ModelPrice")
  @@index([providerId])
  @@index([enabled, sortOrder])
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorEmail String
  action     String
  targetType String
  targetId   String?
  summary    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

// 小时级指标快照：bucketStart 为整点 UTC；value 按 metric 语义为求和/均值/分位值。
model MetricBucket {
  id            String   @id @default(uuid())
  bucketStart   DateTime
  metric        String
  dimensionType String   @default("global") // global | model | tenant | tool
  dimensionId   String   @default("")
  value         Float
  count         Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([bucketStart, metric, dimensionType, dimensionId])
  @@index([metric, bucketStart])
  @@index([dimensionType, dimensionId, bucketStart])
}

model AlertRule {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  metric          String
  comparator      String   // gt | lt
  threshold       Float
  windowMinutes   Int
  cooldownMinutes Int
  severity        String   // warning | critical
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AlertEvent {
  id             String    @id @default(uuid())
  ruleId         String
  ruleName       String
  status         String    // firing | resolved
  value          Float
  message        String
  startedAt      DateTime
  resolvedAt     DateTime?
  notifiedAt     DateTime?
  deliveryStatus String?   // sent | failed | skipped
  deliveryError  String?
  // firing 时为 ruleId，resolved 置 null：借 PostgreSQL 唯一索引允许多 NULL，
  // 从数据库层保证每条规则最多一个未恢复事件，多实例并发也不会重复建。
  openKey        String?   @unique
  createdAt      DateTime  @default(now())

  @@index([ruleId, startedAt])
  @@index([status, startedAt])
  @@index([startedAt])
}
