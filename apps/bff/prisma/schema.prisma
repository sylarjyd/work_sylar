generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  type      String   @default("personal")
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now())
  users     User[]
  sessions  Session[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  sessions     Session[]

  @@index([tenantId])
}

model Session {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String   @default("新会话")
  status    String   @default("active")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  messages  Message[]
  tasks     Task[]
  artifacts Artifact[]

  @@index([tenantId, userId])
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  seq       Int
  tokens    Int?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, seq])
}

model Task {
  id        String   @id @default(uuid())
  sessionId String
  goal      String
  status    String   @default("queued")
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
  runs      Run[]

  @@index([sessionId])
}

model Run {
  id        String    @id @default(uuid())
  taskId    String
  status    String    @default("running")
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  task      Task      @relation(fields: [taskId], references: [id])
  steps     Step[]
  artifacts Artifact[]

  @@index([taskId])
}

model Step {
  id      String   @id @default(uuid())
  runId   String
  seq     Int
  type    String
  payload Json
  ts      DateTime @default(now())
  run     Run      @relation(fields: [runId], references: [id])

  @@unique([runId, seq])
}

model Artifact {
  id         String   @id @default(uuid())
  tenantId   String
  sessionId  String
  runId      String
  kind       String   // docx | xlsx | pptx
  filename   String
  storageKey String
  size       Int
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id])
  run        Run      @relation(fields: [runId], references: [id])

  @@index([sessionId])
  @@index([tenantId])
}

model KbDoc {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  filename   String
  mime       String
  size       Int
  storageKey String
  status     String    @default("pending") // pending | ready | failed
  chunkCount Int       @default(0)
  error      String?
  createdAt  DateTime  @default(now())
  chunks     KbChunk[]

  @@index([tenantId, userId])
}

model KbChunk {
  id        String                      @id @default(uuid())
  docId     String
  tenantId  String
  userId    String
  seq       Int
  text      String
  // pgvector 列：Prisma 无法原生建模；写入/向量查询走 $executeRaw / $queryRaw（见 §4.3）。
  vector    Unsupported("vector(1024)")
  createdAt DateTime                    @default(now())
  doc       KbDoc                       @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([tenantId, userId])
}
