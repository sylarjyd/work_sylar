generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  type      String   @default("personal")
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now())
  users     User[]
  sessions  Session[]
  subscription Subscription?
  credit       TenantCredit?
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  status       String   @default("active")
  role         String   @default("member")
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  sessions     Session[]

  @@index([tenantId])
}

model Session {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String   @default("新会话")
  status    String   @default("active")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  messages  Message[]
  tasks     Task[]
  artifacts Artifact[]

  @@index([tenantId, userId])
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  seq       Int
  tokens    Int?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, seq])
}

model Task {
  id        String   @id @default(uuid())
  sessionId String
  goal      String
  status    String   @default("queued")
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
  runs      Run[]

  @@index([sessionId])
}

model Run {
  id        String    @id @default(uuid())
  taskId    String
  status    String    @default("running")
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  task      Task      @relation(fields: [taskId], references: [id])
  steps     Step[]
  artifacts Artifact[]

  @@index([taskId])
}

model Step {
  id      String   @id @default(uuid())
  runId   String
  seq     Int
  type    String
  payload Json
  ts      DateTime @default(now())
  run     Run      @relation(fields: [runId], references: [id])

  @@unique([runId, seq])
}

model Artifact {
  id         String   @id @default(uuid())
  tenantId   String
  sessionId  String
  runId      String
  kind       String   // docx | xlsx | pptx
  filename   String
  storageKey String
  size       Int
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id])
  run        Run      @relation(fields: [runId], references: [id])

  @@index([sessionId])
  @@index([tenantId])
}

model KbDoc {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  filename   String
  mime       String
  size       Int
  storageKey String
  status     String    @default("pending") // pending | ready | failed
  chunkCount Int       @default(0)
  error      String?
  createdAt  DateTime  @default(now())
  chunks     KbChunk[]

  @@index([tenantId, userId])
}

model KbChunk {
  id        String                      @id @default(uuid())
  docId     String
  tenantId  String
  userId    String
  seq       Int
  text      String
  // pgvector 列：Prisma 无法原生建模；写入/向量查询走 $executeRaw / $queryRaw（见 §4.3）。
  vector    Unsupported("vector(1024)")
  createdAt DateTime                    @default(now())
  doc       KbDoc                       @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@index([tenantId, userId])
}

model Connector {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  command         String
  args            Json
  // AES-256-GCM: base64(IV ‖ authTag ‖ ciphertext)；永不回传前端。
  envEncrypted    String
  enabled         Boolean   @default(true)
  toolCount       Int       @default(0)
  lastValidatedAt DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Plan {
  id                  String         @id
  name                String
  priceCents          Int
  monthlyBaseCredits  Int
  monthlyBonusCredits Int
  maxCreditsPerRun    Int
  rpm                 Int
  allowedModels       String[]
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  subscriptions       Subscription[]
}

model Subscription {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  planId      String
  status      String   @default("active")
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        Plan     @relation(fields: [planId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([planId])
}

model CreditLot {
  id        String    @id @default(uuid())
  tenantId  String
  source    String
  granted   Int
  remaining Int
  expiresAt DateTime?
  note      String?
  createdAt DateTime  @default(now())

  @@index([tenantId, expiresAt])
  @@index([expiresAt])
}

model CreditTx {
  id        String   @id @default(uuid())
  tenantId  String
  type      String
  amount    Int
  source    String?
  runId     String?  @unique
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model TenantCredit {
  tenantId  String   @id
  balance   Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model CreditHold {
  runId     String   @id
  tenantId  String
  amount    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([tenantId])
  @@index([expiresAt])
}

model UsageRecord {
  id           String    @id @default(uuid())
  runId        String    @unique
  tenantId     String
  userId       String
  sessionId    String
  models       Json
  inputTokens  Int
  outputTokens Int
  credits      Int?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  settledAt    DateTime?

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

model ModelPrice {
  model                   String   @id
  inputMilliCreditsPer1k  Int
  outputMilliCreditsPer1k Int
  updatedAt               DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorEmail String
  action     String
  targetType String
  targetId   String?
  summary    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}
