{
  "name": "@ai-office/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "WorkSylar 桌面客户端（Electron 套壳 Web 工作台）",
  "main": "main.cjs",
  "scripts": {
    "dev": "cross-env WORKBUDDY_URL=http://localhost:3000 electron .",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
