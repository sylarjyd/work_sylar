# 一键容器部署配置模板。
# 推荐直接运行 deploy.cmd / ./deploy.sh，由脚本复制本文件并生成随机密钥；
# 手工部署时：cp .env.docker.example .env.docker，然后填写所有空值。
# .env.docker 含明文密钥，已在 .gitignore 中排除，请勿提交。

# 暴露到宿主机的端口（冲突时可改）
WEB_PORT=3000
BFF_PORT=4000

# 浏览器访问 BFF 的地址：构建期内联进 web，远程部署须改为对外可达地址，
# 例如 http://192.168.1.10:4000 或 https://api.example.com，修改后需重建 web 镜像。
WEB_BFF_URL=http://localhost:4000
APP_VERSION=dev

# 运营端（可选，profile admin）：独立 Next.js 应用，通常部署在内网。
# 同机附加：./deploy.sh --with-admin；单独部署：./deploy.sh --admin-only。
ADMIN_WEB_PORT=3001
# 默认只绑定回环地址；内网其他机器访问时改为内网网卡 IP 或 0.0.0.0（务必配好防火墙）。
ADMIN_WEB_BIND=127.0.0.1
# 运营人员浏览器访问 BFF 的地址（构建期内联进 admin），跨网部署时改成内网可达地址。
ADMIN_BFF_URL=http://localhost:4000
# 客户端工作台地址，用于运营端“返回工作台”外链；留空则不显示。
WORKSPACE_URL=
# 运营端对外地址：注入 BFF 用于告警跳转，并作为客户端里“运营平台”外链；
# 留空时客户端不显示该入口（告警仍回退 http://localhost:3001）。
ADMIN_WEB_URL=http://localhost:3001

# 基础设施（由部署脚本生成随机口令）
POSTGRES_USER=ai_office
POSTGRES_DB=ai_office
POSTGRES_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
S3_BUCKET=artifacts

# 应用密钥（由部署脚本生成随机值；CONNECTOR_ENC_KEY 必须是 32 字节 hex）
JWT_SECRET=
CONNECTOR_ENC_KEY=
AGENT_RUNTIME_TOKEN=
INTERNAL_TOKEN=
ALERT_WEBHOOK_SECRET=

# 模型与外部服务（留空时 Agent 走确定性 Mock，链路仍可验证；知识库嵌入不可用）
DEEPSEEK_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
TAVILY_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# 可观测性 / 告警（可选）
LOG_LEVEL=info
ALERTS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
ALERT_WEBHOOK_URL=
