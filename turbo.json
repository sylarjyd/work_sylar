{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "PORT",
    "AGENT_RUNTIME_HOST",
    "AGENT_RUNTIME_PORT",
    "AGENT_RUNTIME_URL",
    "AGENT_RUNTIME_TOKEN",
    "NEXT_PUBLIC_BFF_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "NEXT_PUBLIC_WORKSPACE_URL",
    "DATABASE_URL",
    "JWT_SECRET",
    "DEEPSEEK_API_KEY",
    "MODEL_BASE_URL",
    "MODEL_NAME",
    "TAVILY_API_KEY",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "CONFIRM_TIMEOUT_MS",
    "CODE_EXEC_TIMEOUT_MS",
    "CODE_EXEC_MAX_OLD_SPACE_MB",
    "CODE_EXEC_MAX_OUTPUT_BYTES",
    "EMBEDDING_BASE_URL",
    "EMBEDDING_API_KEY",
    "EMBEDDING_MODEL",
    "EMBEDDING_DIM",
    "BFF_INTERNAL_URL",
    "INTERNAL_TOKEN",
    "KB_CHUNK_SIZE",
    "KB_CHUNK_OVERLAP",
    "KB_MAX_FILE_BYTES",
    "CONNECTOR_ENC_KEY",
    "MCP_HEARTBEAT_MS",
    "MCP_BACKOFF_BASE_MS",
    "MCP_BACKOFF_MAX_MS",
    "MCP_INIT_TIMEOUT_MS",
    "MCP_CALL_TIMEOUT_MS",
    "LOG_LEVEL",
    "LOG_PRETTY",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_TRACES_SAMPLER_ARG",
    "METRICS_ROLLUP_MS",
    "METRICS_BACKFILL_HOURS",
    "METRICS_RETENTION_DAYS",
    "ALERT_RETENTION_DAYS",
    "ALERTS_ENABLED",
    "ALERT_EVAL_MS",
    "ALERT_MAX_PER_HOUR",
    "ALERT_WEBHOOK_URL",
    "ALERT_WEBHOOK_SECRET",
    "ADMIN_WEB_URL",
    "APP_VERSION"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },
    "test": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true }
  }
}
