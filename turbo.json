{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "PORT",
    "AGENT_RUNTIME_HOST",
    "AGENT_RUNTIME_PORT",
    "AGENT_RUNTIME_URL",
    "AGENT_RUNTIME_TOKEN",
    "NEXT_PUBLIC_BFF_URL",
    "DATABASE_URL",
    "JWT_SECRET",
    "DEEPSEEK_API_KEY",
    "MODEL_BASE_URL",
    "MODEL_NAME",
    "TAVILY_API_KEY",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "CONFIRM_TIMEOUT_MS",
    "CODE_EXEC_TIMEOUT_MS",
    "CODE_EXEC_MAX_OLD_SPACE_MB",
    "CODE_EXEC_MAX_OUTPUT_BYTES"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },
    "test": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true }
  }
}
