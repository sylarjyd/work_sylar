DATABASE_URL=postgresql://ai_office:ai_office@localhost:5432/ai_office?schema=public
JWT_SECRET=change-me
DEEPSEEK_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
TAVILY_API_KEY=
AGENT_RUNTIME_URL=http://localhost:4001
NEXT_PUBLIC_BFF_URL=http://localhost:4000
# bff 监听端口
PORT=4000
# agent-runtime 监听地址与端口（默认仅本机；暴露到网络须设 0.0.0.0 并配下方 token）
AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=4001
# BFF→runtime 共享密钥；设置后 runtime 强制校验 x-agent-runtime-token 头
AGENT_RUNTIME_TOKEN=
# MinIO（S3 兼容）对象存储：runtime 写、bff 读，桶由 runtime 启动时幂等创建
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=artifacts
