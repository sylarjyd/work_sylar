DATABASE_URL=postgresql://ai_office:ai_office@localhost:5432/ai_office?schema=public
JWT_SECRET=change-me
DEEPSEEK_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
TAVILY_API_KEY=
AGENT_RUNTIME_URL=http://localhost:4001
NEXT_PUBLIC_BFF_URL=http://localhost:4000
# bff 监听端口
PORT=4000
# agent-runtime 监听地址与端口（默认仅本机；暴露到网络须设 0.0.0.0 并配下方 token）
AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=4001
# BFF→runtime 共享密钥；设置后 runtime 强制校验 x-agent-runtime-token 头，未设置时仅放行回环来源
AGENT_RUNTIME_TOKEN=
# MinIO（S3 兼容）对象存储：runtime 写、bff 读，桶由 runtime 启动时幂等创建
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=artifacts
# 确认与代码沙箱
# 确认等待上限（毫秒），到点按拒绝兑现
CONFIRM_TIMEOUT_MS=120000
# code.exec 沙箱单次执行墙钟上限（毫秒）
CODE_EXEC_TIMEOUT_MS=5000
# code.exec 沙箱子进程堆上限（MB）
CODE_EXEC_MAX_OLD_SPACE_MB=128
# code.exec stdout 累计截断阈值（字节）
CODE_EXEC_MAX_OUTPUT_BYTES=65536
# 知识库 RAG（runtime 解析+嵌入；bff 独占 PG 与向量检索）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 必须等于 KbChunk.vector 列维度（pgvector 要求定长）
EMBEDDING_DIM=1024
# runtime 调 BFF 内部检索的地址
BFF_INTERNAL_URL=http://localhost:4000
# runtime↔bff 内部端点共享密钥（空则仅放行回环来源；非本机部署必设）
INTERNAL_TOKEN=
# 切分参数
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=150
# bff 上传大小上限（字节）
KB_MAX_FILE_BYTES=10485760
# 连接器 / MCP
# MCP Server env 的 AES-256-GCM 密钥（32 字节 hex，必须设置；生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
CONNECTOR_ENC_KEY=
# MCP 子进程守护参数
MCP_HEARTBEAT_MS=30000
MCP_BACKOFF_BASE_MS=1000
MCP_BACKOFF_MAX_MS=30000
# initialize / 校验握手超时（毫秒）
MCP_INIT_TIMEOUT_MS=10000
# 单次 tools/call 超时（毫秒）
MCP_CALL_TIMEOUT_MS=30000
# 计费与限流（M5a）
# Redis 用于按租户运行限流；留空则退化为进程内固定窗口（单实例可用）
REDIS_URL=redis://127.0.0.1:6379
# 多模型路由（JSON 数组）；未配置时回退 MODEL_BASE_URL + MODEL_NAME 单模型
# [{"model":"deepseek-chat","baseUrl":"https://api.deepseek.com/v1","apiKeyEnv":"DEEPSEEK_API_KEY"}]
MODEL_PROVIDERS=
# 计费补偿扫描间隔（毫秒），0 表示关闭
BILLING_SWEEP_MS=60000
