DATABASE_URL=postgresql://ai_office:ai_office@localhost:5432/ai_office?schema=public
JWT_SECRET=change-me
DEEPSEEK_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
TAVILY_API_KEY=
AGENT_RUNTIME_URL=http://localhost:4001
NEXT_PUBLIC_BFF_URL=http://localhost:4000
# 运营平台外链（独立应用，开发默认 3001）；未设置时客户端不显示运营平台入口。
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# 运营端“返回工作台”外链；未设置时运营端不显示该入口。
NEXT_PUBLIC_WORKSPACE_URL=http://localhost:3000
# bff 监听端口
PORT=4000
# agent-runtime 监听地址与端口（默认仅本机；暴露到网络须设 0.0.0.0 并配下方 token）
AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=4001
# BFF→runtime 共享密钥；设置后 runtime 强制校验 x-agent-runtime-token 头，未设置时仅放行回环来源
AGENT_RUNTIME_TOKEN=
# MinIO（S3 兼容）对象存储：runtime 写、bff 读，桶由 runtime 启动时幂等创建
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=artifacts
# 确认与代码沙箱
# 确认等待上限（毫秒），到点按拒绝兑现
CONFIRM_TIMEOUT_MS=120000
# code.exec 沙箱单次执行墙钟上限（毫秒）
CODE_EXEC_TIMEOUT_MS=5000
# code.exec 沙箱子进程堆上限（MB）
CODE_EXEC_MAX_OLD_SPACE_MB=128
# code.exec stdout 累计截断阈值（字节）
CODE_EXEC_MAX_OUTPUT_BYTES=65536
# 知识库 RAG（runtime 解析+嵌入；bff 独占 PG 与向量检索）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 必须等于 KbChunk.vector 列维度（pgvector 要求定长）
EMBEDDING_DIM=1024
# runtime 调 BFF 内部检索的地址
BFF_INTERNAL_URL=http://localhost:4000
# runtime↔bff 内部端点共享密钥（空则仅放行回环来源；非本机部署必设）
INTERNAL_TOKEN=
# 切分参数
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=150
# bff 上传大小上限（字节）
KB_MAX_FILE_BYTES=10485760
# 连接器 / MCP
# MCP Server env 的 AES-256-GCM 密钥（32 字节 hex，必须设置；生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
CONNECTOR_ENC_KEY=
# 模型厂商 API Key 的 AES-256-GCM 密钥（32 字节 hex，必须设置；与连接器密钥分开轮换）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODEL_ENC_KEY=
# 厂商 Base URL 默认禁止回环、内网与链路本地地址（SSRF 防护）；
# 确有内网/本机部署的模型服务（如 Ollama）时设为 1。云元数据地址始终拒绝。
# MODEL_ALLOW_PRIVATE_BASE_URL=1
# MCP 子进程守护参数
MCP_HEARTBEAT_MS=30000
MCP_BACKOFF_BASE_MS=1000
MCP_BACKOFF_MAX_MS=30000
# initialize / 校验握手超时（毫秒）
MCP_INIT_TIMEOUT_MS=10000
# 单次 tools/call 超时（毫秒）
MCP_CALL_TIMEOUT_MS=30000
# 计费与限流（M5a）
# Redis 用于按租户运行限流；留空则退化为进程内固定窗口（单实例可用）
REDIS_URL=redis://127.0.0.1:6379
# 多模型路由（JSON 数组）；未配置时回退 MODEL_BASE_URL + MODEL_NAME 单模型
# modalities 可选，取值 text/image/audio/video；缺省按 text
# [{"model":"deepseek-chat","baseUrl":"https://api.deepseek.com/v1","apiKeyEnv":"DEEPSEEK_API_KEY","modalities":["text"]}]
MODEL_PROVIDERS=
# 计费补偿扫描间隔（毫秒），0 表示关闭
BILLING_SWEEP_MS=60000

# 可观测性（M5b-2）
# 日志级别 trace/debug/info/warn/error/fatal；生产建议 info
LOG_LEVEL=info
# 1 时启用 pino-pretty 彩色输出（仅本地开发）
LOG_PRETTY=0
# OTLP/HTTP 端点（如 http://127.0.0.1:4318）；留空则不导出 trace
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP 请求头，逗号分隔 key=urlencoded-value，如 authorization=Bearer%20xxx
OTEL_EXPORTER_OTLP_HEADERS=
# trace 采样率 0–1
OTEL_TRACES_SAMPLER_ARG=1.0
# 指标聚合间隔（毫秒，最小 10000；0 关闭定时任务）
METRICS_ROLLUP_MS=300000
# 首次启动回填小时数（1–168）
METRICS_BACKFILL_HOURS=24
# 指标桶保留天数（1–3650）
METRICS_RETENTION_DAYS=90
# 告警历史保留天数（1–3650）
ALERT_RETENTION_DAYS=90
# 告警评估总开关（也可在管理端参数页修改）
ALERTS_ENABLED=true
# 告警评估间隔（毫秒，最小 5000；0 关闭评估）
ALERT_EVAL_MS=60000
# Webhook 每小时投递上限
ALERT_MAX_PER_HOUR=60
# 告警 Webhook 初始配置；管理端参数页写入的 DB 值优先
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# 运营平台地址（独立应用）：告警消息中的跳转地址
ADMIN_WEB_URL=http://localhost:3001

# ---- 任务队列（M5b-3）----
# 未配置 REDIS_URL 时运行内联执行（开发/单机）；配置后由 BullMQ 队列分发到各 BFF 实例的 worker。
RUN_QUEUE_ENABLED=1
RUN_QUEUE_NAME=runs
RUN_QUEUE_CONCURRENCY=4
RUN_QUEUE_MAX_ATTEMPTS=2
RUN_QUEUE_PER_TENANT=2
RUN_QUEUE_MAX_PER_TENANT=50
